#ifndef INTERPOLATE_H
#define INTERPOLATE_H

#include <NTL/ZZ.h>
#include <NTL/ZZ_p.h>
#include <NTL/vec_ZZ_p.h>
#include <NTL/ZZ_pXFactoring.h>
#include <vector>
#include <iostream>
#include <set>
#include <cassert>

using namespace NTL;

// assumes constant term is 0, hence set as default, Step 5, part c
ZZ_p interpolate_polynomial(Vec<ZZ_p> X, Vec<ZZ_p> Y, ZZ_p eval_at = ZZ_p(0));

// Build (x - a) as a ZZ_pX
inline ZZ_pX linear_factor(const ZZ_p& a) {
        ZZ_pX t;
	SetCoeff(t, 1, ZZ_p(1));   // x
        SetCoeff(t, 0, -a);        // -a
        return t;
}

// 1) Explicit interpolation: return P(x) as ZZ_pX
inline ZZ_pX interpolate_polynomial_ZZ_pX(const Vec<ZZ_p>& X, const Vec<ZZ_p>& Y) {
        const long n = X.length();
        assert(n == Y.length());
            assert(n >= 1);

            for (long i = 0; i < n; i++) {
                        for (long j = i + 1; j < n; j++) {
                                    assert(X[i] != X[j]);
                        }
            }

            ZZ_pX P;

            for (long i = 0; i < n; i++) {
                        ZZ_pX Ni;
                        SetCoeff(Ni, 0, ZZ_p(1));

                        ZZ_p di = ZZ_p(1);

                        for (long j = 0; j < n; j++) {
                                    if (j == i) {
                                                continue;
                                    }

                                    Ni *= linear_factor(X[j]);
                                    di *= (X[i] - X[j]);
                        }

                        ZZ_p scale = Y[i] * inv(di);
                        P += scale * Ni;
            }

            return P;
}

// Extract root from linear polynomial a1*x + a0
inline ZZ_p root_from_linear(const ZZ_pX& g) {
            assert(deg(g) == 1);

            const ZZ_p a0 = coeff(g, 0);
            const ZZ_p a1 = coeff(g, 1);

            assert(a1 != ZZ_p(0));

            return (-a0) * inv(a1);
}

// Roots of interpolated polynomial
inline Vec<ZZ_p> roots_of_interpolated_polynomial(const Vec<ZZ_p>& X, const Vec<ZZ_p>& Y) {
            ZZ_pX P = interpolate_polynomial_ZZ_pX(X, Y);

            Vec<ZZ_p> roots;
            roots.SetLength(0);

            if (deg(P) <= 0) {
                        return roots;
            }

            ZZ_p content;
            vec_pair_ZZ_pX_long factors;

            factor(content, factors, P);

            std::set<ZZ> seen;

            for (long k = 0; k < factors.length(); k++) {
                        const ZZ_pX& g = factors[k].a;

                        if (deg(g) == 1) {
                                    ZZ_p r = root_from_linear(g);
                                    ZZ rr = rep(r);

                                    if (seen.insert(rr).second) {
                                                roots.append(r);
                                    }
                        }
            }

            return roots;
}




#endif
